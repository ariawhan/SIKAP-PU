DJANGO_SECRET_KEY=ganti-dengan-secret-key-yang-panjang-dan-acak
DJANGO_DEBUG=True
DJANGO_BROWSER_AUTO_RELOAD=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,*
APP_NAME=SIKAP-PU
APP_FULL_NAME=SISTEM INFORMASI KENDALI ADMINISTRASI PERKARA TINDAK PIDANA UMUM PADA TAHAP PRA PENUNTUTAN BERBASIS WEB DENGAN AUTOMATIC REMINDER WHATSAPP DAN TELEGRAM
DB_NAME=sikap_pu_db
# Database lama akan disalin satu kali bila database baru masih kosong.
LEGACY_DB_NAMES=pidum_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_EMAIL=superadmin@kejaksaan.go.id
# Opsional: isi agar password awal tidak dibuat acak.
INITIAL_ADMIN_PASSWORD=
WA_GATEWAY_URL=http://127.0.0.1:3001
WA_GATEWAY_API_KEY=ganti-dengan-secret-yang-panjang
WA_GATEWAY_SESSION=sikap-pu-main
# Browser koneksi SIPede. Proxy Windows dicoba lebih dulu lalu otomatis fallback ke koneksi langsung.
SIPEDE_BROWSER_USE_SYSTEM_PROXY=1
# 0 = tampilkan jendela Chrome saat login/CAPTCHA, 1 = jalankan di latar belakang.
SIPEDE_BROWSER_HEADLESS=0
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
